# Paste the full RPC URL, including the API key.
# A network is available only after its URL is set.

# Ethereum mainnet. Example: https://eth-mainnet.g.alchemy.com/v2/your_key
ETHEREUM_RPC_URL=

# Ethereum Sepolia. Example: https://eth-sepolia.g.alchemy.com/v2/your_key
SEPOLIA_RPC_URL=

# Polygon mainnet. Example: https://polygon-mainnet.g.alchemy.com/v2/your_key
POLYGON_RPC_URL=

# Polygon Amoy testnet. Example: https://polygon-amoy.g.alchemy.com/v2/your_key
AMOY_RPC_URL=

# BNB Smart Chain mainnet. Example: https://bnb-mainnet.g.alchemy.com/v2/your_key
BNB_RPC_URL=

# BNB Smart Chain testnet. Example: https://bnb-testnet.g.alchemy.com/v2/your_key
BNB_TESTNET_RPC_URL=

# One deployer key per network: 64 hex characters, 0x prefix optional.
# A key is read only when that network is used. Use a different key on each network.
ETHEREUM_PRIVATE_KEY=
SEPOLIA_PRIVATE_KEY=
POLYGON_PRIVATE_KEY=
AMOY_PRIVATE_KEY=
BNB_PRIVATE_KEY=
BNB_TESTNET_PRIVATE_KEY=

# Deploy settings, read by scripts/deploy.js.
# Seconds a reservation locks the seller's deposit before the seller can reclaim it. Defaults to 3600.
RESERVATION_TIMEOUT_SECONDS=3600
# Per-network limits are in that network's native coin. The admin can change them later with setDepositLimits.
# These are initial caps; review and adjust them for your expected usage and risk before deployment.
ETHEREUM_MAX_DEPOSIT=2.00
ETHEREUM_MAX_OUTSTANDING=35.00
SEPOLIA_MAX_DEPOSIT=2.00
SEPOLIA_MAX_OUTSTANDING=35.00
POLYGON_MAX_DEPOSIT=10000
POLYGON_MAX_OUTSTANDING=200000
AMOY_MAX_DEPOSIT=10000
AMOY_MAX_OUTSTANDING=200000
BNB_MAX_DEPOSIT=9.00
BNB_MAX_OUTSTANDING=170.00
BNB_TESTNET_MAX_DEPOSIT=9.00
BNB_TESTNET_MAX_OUTSTANDING=170.00

# Etherscan API key for `hardhat verify` on every configured network.
ETHERSCAN_API_KEY=

# EmpiyaP2P address for each network, filled in after that network's deploy.
ETHEREUM_CONTRACT_ADDRESS=
SEPOLIA_CONTRACT_ADDRESS=
POLYGON_CONTRACT_ADDRESS=
AMOY_CONTRACT_ADDRESS=
BNB_CONTRACT_ADDRESS=
BNB_TESTNET_CONTRACT_ADDRESS=

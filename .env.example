# Paste the full RPC URL, including the API key.
# A network is available only after its URL is set.

# Ethereum mainnet. Example: https://eth-mainnet.g.alchemy.com/v2/your_key
ETHEREUM_RPC_URL=

# Ethereum Sepolia. Example: https://eth-sepolia.g.alchemy.com/v2/your_key
SEPOLIA_RPC_URL=

# BNB Smart Chain mainnet (optional later). Example: https://bnb-mainnet.g.alchemy.com/v2/your_key
BNB_RPC_URL=

# BNB Smart Chain testnet (optional later). Example: https://bnb-testnet.g.alchemy.com/v2/your_key
BNB_TESTNET_RPC_URL=

# One deployer key per network: 64 hex characters, 0x prefix optional.
# A key is read only when that network is used. Use a different key on each network.
ETHEREUM_PRIVATE_KEY=
SEPOLIA_PRIVATE_KEY=
BNB_PRIVATE_KEY=
BNB_TESTNET_PRIVATE_KEY=

# Deploy settings, read by scripts/deploy.js and scripts/deploy-payments.js.
# Seconds a reservation locks the seller's deposit before the seller can reclaim it. Defaults to 3600.
RESERVATION_TIMEOUT_SECONDS=3600
# Seconds before a payer may claimBack an unsettled payment. Defaults to 604800 (7 days).
PAYMENT_CLAIM_DELAY_SECONDS=604800

# USDT token and limits. Amounts are human USDT (for example 500), not base units.
# Source: https://tether.to/en/supported-protocols/
# Ethereum USD₮ (official): 0xdAC17F958D2ee523a2206206994597C13D831ec7 — 6 decimals.
# Sepolia has no official USDT; use pnpm deploy:mock-usdt:sepolia.
# BNB Smart Chain: that page lists XAU₮ only, not USD₮. Common BEP-20 "USDT" is Binance-Peg BSC-USD,
# not Tether-issued. Leave BNB_USDT_ADDRESS blank unless you deliberately choose that path later.
ETHEREUM_USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
ETHEREUM_USDT_DECIMALS=6
ETHEREUM_MAX_DEPOSIT_USDT=500
ETHEREUM_MAX_OUTSTANDING_USDT=5000
ETHEREUM_MAX_PAYMENT_USDT=200
ETHEREUM_MAX_PENDING_USDT=2000
ETHEREUM_OPERATOR_ADDRESS=
ETHEREUM_PAYMENTS_OPERATOR_ADDRESS=
ETHEREUM_TREASURY_ADDRESS=

SEPOLIA_USDT_ADDRESS=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06
SEPOLIA_USDT_DECIMALS=6
SEPOLIA_MAX_DEPOSIT_USDT=500
SEPOLIA_MAX_OUTSTANDING_USDT=5000
SEPOLIA_MAX_PAYMENT_USDT=200
SEPOLIA_MAX_PENDING_USDT=2000
SEPOLIA_OPERATOR_ADDRESS=
SEPOLIA_PAYMENTS_OPERATOR_ADDRESS=
SEPOLIA_TREASURY_ADDRESS=

# Optional later: BNB Smart Chain (Binance-Peg path, not native Tether USD₮).
BNB_USDT_ADDRESS=
BNB_USDT_DECIMALS=18
BNB_MAX_DEPOSIT_USDT=500
BNB_MAX_OUTSTANDING_USDT=5000
BNB_MAX_PAYMENT_USDT=200
BNB_MAX_PENDING_USDT=2000
BNB_OPERATOR_ADDRESS=
BNB_PAYMENTS_OPERATOR_ADDRESS=
BNB_TREASURY_ADDRESS=

BNB_TESTNET_USDT_ADDRESS=
BNB_TESTNET_USDT_DECIMALS=18
BNB_TESTNET_MAX_DEPOSIT_USDT=500
BNB_TESTNET_MAX_OUTSTANDING_USDT=5000
BNB_TESTNET_MAX_PAYMENT_USDT=200
BNB_TESTNET_MAX_PENDING_USDT=2000
BNB_TESTNET_OPERATOR_ADDRESS=
BNB_TESTNET_PAYMENTS_OPERATOR_ADDRESS=
BNB_TESTNET_TREASURY_ADDRESS=

# Optional mint targets for scripts/deploy-mock-usdt.js (comma-separated). Defaults to the deployer.
MOCK_USDT_MINT_TO=
MOCK_USDT_MINT_AMOUNT=1000000

# Etherscan API key for `hardhat verify` on every configured network.
ETHERSCAN_API_KEY=

# Contract addresses, filled in after each network's deploy.
ETHEREUM_CONTRACT_ADDRESS=
SEPOLIA_CONTRACT_ADDRESS=
BNB_CONTRACT_ADDRESS=
BNB_TESTNET_CONTRACT_ADDRESS=
ETHEREUM_PAYMENTS_ADDRESS=
SEPOLIA_PAYMENTS_ADDRESS=
BNB_PAYMENTS_ADDRESS=
BNB_TESTNET_PAYMENTS_ADDRESS=

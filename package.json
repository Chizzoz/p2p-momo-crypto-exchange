{
  "name": "p2p-momo-crypto-exchange",
  "version": "0.1.0",
  "description": "A P2P Mobile Money Crypto eXchange",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:ethereum": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:bnb": "hardhat run scripts/deploy.js --network bsc",
    "deploy:bnb-testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy-payments": "hardhat run scripts/deploy-payments.js",
    "deploy-payments:ethereum": "hardhat run scripts/deploy-payments.js --network mainnet",
    "deploy-payments:sepolia": "hardhat run scripts/deploy-payments.js --network sepolia",
    "deploy-payments:bnb": "hardhat run scripts/deploy-payments.js --network bsc",
    "deploy-payments:bnb-testnet": "hardhat run scripts/deploy-payments.js --network bscTestnet",
    "deploy:mock-usdt:bnb-testnet": "hardhat run scripts/deploy-mock-usdt.js --network bscTestnet",
    "deploy:mock-usdt:sepolia": "hardhat run scripts/deploy-mock-usdt.js --network sepolia",
    "interact:ethereum": "hardhat run scripts/interact.js --network mainnet",
    "interact:sepolia": "hardhat run scripts/interact.js --network sepolia",
    "interact:bnb": "hardhat run scripts/interact.js --network bsc",
    "interact:bnb-testnet": "hardhat run scripts/interact.js --network bscTestnet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chizzoz/p2p-momo-crypto-exchange.git"
  },
  "author": "Chinyanta Mwenya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Chizzoz/p2p-momo-crypto-exchange/issues"
  },
  "homepage": "https://github.com/Chizzoz/p2p-momo-crypto-exchange#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "chai": "^5.3.3",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "^16.0.3"
  }
}
